    {
      "id": "31-extend-trial",
      "file": "31-extend-trial.png",
      "steps": [
        {
          "click": ".drawer button[aria-label='Close panel']"
        },
        {
          "wait": 400
        },
        {
          "click": "nav.crumbs a"
        },
        {
          "waitFor": "table.data"
        },
        {
          "click": "text=Acme Logistics"
        },
        {
          "waitForText": "Usage vs limits"
        },
        {
          "click": "button[aria-label='Actions']"
        },
        {
          "click": "text=Extend trial…"
        },
        {
          "waitForText": "Extend the trial by (days)"
        },
        {
          "eval": "document.querySelectorAll('.drawer').forEach(d => { d.style.height = 'auto'; d.style.alignSelf = 'flex-start'; for (let p = d.parentElement; p && !p.classList.contains('cdk-overlay-container'); p = p.parentElement) { if (p.classList.contains('cdk-global-overlay-wrapper')) break; p.style.height = 'auto'; } })"
        },
        {
          "hover": ".drawer h2"
        }
      ],
      "clip": ".drawer",
      "clipPadding": 0
    },
    {
      "id": "31-suspended-tenant",
      "file": "31-suspended-tenant.png",
      "steps": [
        {
          "click": ".drawer button[aria-label='Close panel']"
        },
        {
          "wait": 400
        },
        {
          "click": "nav.crumbs a"
        },
        {
          "waitFor": "table.data"
        },
        {
          "click": "text=Globex Retail"
        },
        {
          "waitFor": ".callout--danger"
        }
      ],
      "highlight": [
        ".callout--danger"
      ]
    },
    {
      "id": "31-plans",
      "file": "31-plans.png",
      "steps": [
        {
          "click": "nav[aria-label='Platform console'] a[href$='/platform/plans']"
        },
        {
          "waitForText": "Prices, limits and features offered to tenants."
        },
        {
          "waitFor": ".cards sd-card"
        }
      ],
      "highlight": [
        "sd-page-header button",
        ".cards > sd-card:nth-child(2) .badges",
        ".cards > sd-card:nth-child(2) .price",
        ".cards > sd-card:nth-child(2) desk-plan-limits",
        ".cards > sd-card:nth-child(2) .feats",
        ".cards > sd-card:nth-child(2) .footer"
      ],
      "numbered": true,
      "fullPage": true
    },
    {
      "id": "31-plan-editor",
      "file": "31-plan-editor.png",
      "steps": [
        {
          "click": ".cards > sd-card:nth-child(3) .footer button:last-child"
        },
        {
          "waitForText": "Edit plan"
        },
        {
          "eval": "document.querySelectorAll('.drawer').forEach(d => { d.style.height = 'auto'; d.style.alignSelf = 'flex-start'; for (let p = d.parentElement; p && !p.classList.contains('cdk-overlay-container'); p = p.parentElement) { if (p.classList.contains('cdk-global-overlay-wrapper')) break; p.style.height = 'auto'; } })"
        },
        {
          "hover": ".drawer h2"
        }
      ],
      "clip": ".drawer",
      "clipPadding": 0
    },
    {
      "id": "31-delete-plan",
      "file": "31-delete-plan.png",
      "steps": [
        {
          "click": ".drawer button[aria-label='Close panel']"
        },
        {
          "wait": 400
        },
        {
          "click": ".cards > sd-card:nth-child(3) button[aria-label^='Delete']"
        },
        {
          "waitFor": "sd-confirm-dialog sd-dialog"
        },
        {
          "hover": "sd-confirm-dialog .head"
        }
      ],
      "clip": "sd-confirm-dialog sd-dialog",
      "clipPadding": 0
    },
    {
      "id": "31-invoices",
      "file": "31-invoices.png",
      "steps": [
        {
          "click": "sd-confirm-dialog button[aria-label='Close dialog']"
        },
        {
          "wait": 400
        },
        {
          "click": "nav[aria-label='Platform console'] a[href$='/platform/invoices']"
        },
        {
          "waitFor": "table.data"
        }
      ],
      "highlight": [
        ".toolbar sd-form-field",
        "table.data tbody tr:first-child button.linkish",
        "table.data tbody tr:first-child td:nth-child(2) a",
        "table.data tbody tr:nth-child(2) sd-badge",
        "table.data tbody tr:first-child td.actions button"
      ],
      "numbered": true
    },
    {
      "id": "31-invoice-detail",
      "file": "31-invoice-detail.png",
      "steps": [
        {
          "click": "table.data tbody tr:first-child button.linkish"
        },
        {
          "waitForText": "Download PDF"
        },
        {
          "eval": "document.querySelectorAll('.drawer').forEach(d => { d.style.height = 'auto'; d.style.alignSelf = 'flex-start'; for (let p = d.parentElement; p && !p.classList.contains('cdk-overlay-container'); p = p.parentElement) { if (p.classList.contains('cdk-global-overlay-wrapper')) break; p.style.height = 'auto'; } })"
        },
