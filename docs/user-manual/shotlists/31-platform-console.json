{
  "baseUrl": "http://localhost:5830",
  "viewport": {
    "width": 1280,
    "height": 800,
    "scale": 1.5
  },
  "outDir": "../shots",
  "colorScheme": "light",
  "accent": "#8B08AF",
  "hide": [
    "sd-toast-outlet"
  ],
  "setup": [
    {
      "goto": "/platform/login"
    },
    {
      "fill": "label=Operator e-mail",
      "value": "platform@supportdesk.demo"
    },
    {
      "fill": "label=Password",
      "value": "${env:SD_PLATFORM_PASSWORD}"
    },
    {
      "click": "form button[type=submit]"
    },
    {
      "waitForText": "Tenants, revenue and what needs attention."
    }
  ],
  "shots": [
    {
      "id": "31-overview",
      "file": "31-overview.png",
      "waitFor": "text=Recent platform activity",
      "highlight": [
        "nav[aria-label='Platform console']",
        ".me",
        "sd-page-header button",
        ".kpis",
        ".grid > sd-card:first-child",
        ".grid > sd-card:last-child"
      ],
      "numbered": true
    },
    {
      "id": "31-tenants",
      "file": "31-tenants.png",
      "steps": [
        {
          "click": "nav[aria-label='Platform console'] a[href$='/platform/tenants']"
        },
        {
          "waitFor": "table.data"
        }
      ],
      "highlight": [
        "form.toolbar sd-form-field:nth-of-type(1)",
        "form.toolbar sd-form-field:nth-of-type(2)",
        "form.toolbar button[type=submit]",
        "table.data tbody tr:nth-child(2)"
      ],
      "numbered": true
    },
    {
      "id": "31-tenant-page",
      "file": "31-tenant-page.png",
      "steps": [
        {
          "click": "text=Wings Software"
        },
        {
          "waitForText": "Usage vs limits"
        }
      ],
      "highlight": [
        "nav.crumbs",
        "button[aria-label='Actions']",
        ".grid > sd-card:first-child",
        ".grid > sd-card:last-child",
        "sd-card.block",
        "h2.section-title:nth-of-type(1) + .table-wrap",
        "h2.section-title:nth-of-type(2) + .table-wrap",
        "ul.timeline"
      ],
      "numbered": true,
      "fullPage": true
    },
    {
      "id": "31-actions-menu",
      "file": "31-actions-menu.png",
      "steps": [
        {
          "click": "button[aria-label='Actions']"
        },
        {
          "waitFor": ".sd-menu"
        }
      ],
      "clip": ".sd-menu",
      "clipPadding": 12
    },
    {
      "id": "31-suspend",
      "file": "31-suspend.png",
      "steps": [
        {
          "click": "text=Suspend…"
        },
        {
          "waitForText": "Suspend tenant"
        },
        {
          "fill": "label=Reason",
          "value": "Customer asked us to pause the workspace during an internal audit."
        },
        {
          "eval": "document.querySelectorAll('.drawer').forEach(d => { d.style.height = 'auto'; d.style.alignSelf = 'flex-start'; for (let p = d.parentElement; p && !p.classList.contains('cdk-overlay-container'); p = p.parentElement) { if (p.classList.contains('cdk-global-overlay-wrapper')) break; p.style.height = 'auto'; } })"
        },
        {
          "hover": ".drawer h2"
        }
      ],
      "clip": ".drawer",
      "clipPadding": 0
    },
    {
      "id": "31-reactivate",
      "file": "31-reactivate.png",
      "steps": [
        {
          "click": ".drawer button[aria-label='Close panel']"
        },
        {
          "wait": 400
        },
        {
          "click": "button[aria-label='Actions']"
        },
        {
          "click": "text=Reactivate"
        },
        {
          "waitForText": "Reactivate tenant"
        },
        {
          "eval": "document.querySelectorAll('.drawer').forEach(d => { d.style.height = 'auto'; d.style.alignSelf = 'flex-start'; for (let p = d.parentElement; p && !p.classList.contains('cdk-overlay-container'); p = p.parentElement) { if (p.classList.contains('cdk-global-overlay-wrapper')) break; p.style.height = 'auto'; } })"
