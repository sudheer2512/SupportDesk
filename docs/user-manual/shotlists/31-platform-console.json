          "hover": ".drawer:has(#inv-action) h2"
        }
      ],
      "clip": ".drawer:has(#inv-action)",
      "clipPadding": 0
    },
    {
      "id": "31-mark-paid",
      "file": "31-mark-paid.png",
      "steps": [
        {
          "click": ".drawer:has(#inv-action) button[aria-label='Close panel']"
        },
        {
          "wait": 400
        },
        {
          "click": ".drawer button[aria-label='Close panel']"
        },
        {
          "wait": 400
        },
        {
          "click": "table.data tbody tr:first-child td.actions button"
        },
        {
          "waitFor": ".drawer:has(#inv-action)"
        },
        {
          "fill": "input[name=ref]",
          "value": "NEFT-2026-11-0042"
        },
        {
          "eval": "document.querySelectorAll('.drawer').forEach(d => { d.style.height = 'auto'; d.style.alignSelf = 'flex-start'; for (let p = d.parentElement; p && !p.classList.contains('cdk-overlay-container'); p = p.parentElement) { if (p.classList.contains('cdk-global-overlay-wrapper')) break; p.style.height = 'auto'; } })"
        },
