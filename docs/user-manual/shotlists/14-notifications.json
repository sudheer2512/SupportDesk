{
  "baseUrl": "http://localhost:5830",
  "viewport": {
    "width": 1280,
    "height": 800,
    "scale": 1.5
  },
  "outDir": "../shots",
  "colorScheme": "light",
  "accent": "#8B08AF",
  "hide": [
    "sd-toast-outlet"
  ],
  "timeoutMs": 30000,
  "setup": [
    {
      "goto": "/login"
    },
    {
      "fill": "label=Workspace",
      "value": "wings"
    },
    {
      "fill": "label=Work e-mail",
      "value": "priya@wings.demo"
    },
    {
      "fill": "label=Password",
      "value": "${env:SD_DESK_PASSWORD}"
    },
    {
      "click": "form button[type=submit]"
    },
    {
      "waitForText": "SLA risk board"
    }
  ],
  "shots": [
    {
      "id": "14-bell",
      "file": "14-bell.png",
      "steps": [
        {
          "wait": 800
        }
      ],
      "highlight": [
        "button.bell"
      ],
      "clip": "header.bar",
      "clipPadding": 0
    },
    {
      "id": "14-bell-panel",
      "file": "14-bell-panel.png",
      "steps": [
        {
          "click": "button.bell"
        },
        {
          "waitFor": "section.panel[aria-label='Notifications']"
        },
        {
          "wait": 1200
        }
      ],
      "clip": "section.panel[aria-label='Notifications']",
      "clipPadding": 0
    },
    {
      "id": "14-notifications-page",
      "file": "14-notifications-page.png",
      "steps": [
        {
          "press": "Escape"
        },
        {
          "wait": 300
        },
        {
          "click": "sd-card[title='Customer replies & mentions'] a"
        },
        {
          "waitForText": "Assignments, mentions, customer replies, SLA alerts and approvals."
        },
        {
          "wait": 1200
        }
      ],
      "highlight": [
        "sd-page-header [sdPageActions]:first-child",
        "text=Mark all read",
        ".seg",
        "select[aria-label='Notification type']",
        ".list .item:first-child .body",
        ".list .item:first-child .actions"
      ],
      "numbered": true
    },
    {
      "id": "14-needs-ack",
      "file": "14-needs-ack.png",
      "steps": [
        {
          "click": ".seg button:nth-child(3)"
        },
        {
          "wait": 600
        }
      ],
      "highlight": [
        ".seg button:nth-child(3)"
      ]
    }
  ]
}
