{
  "baseUrl": "http://localhost:5830",
  "viewport": {
    "width": 1280,
    "height": 800,
    "scale": 1.5
  },
  "outDir": "../shots",
  "colorScheme": "light",
  "accent": "#8B08AF",
  "hide": [
    "sd-toast-outlet"
  ],
  "timeoutMs": 30000,
  "setup": [
    {
      "goto": "/login"
    },
    {
      "fill": "label=Workspace",
      "value": "wings"
    },
    {
      "fill": "label=Work e-mail",
      "value": "arjun@wings.demo"
    },
    {
      "fill": "label=Password",
      "value": "${env:SD_DESK_PASSWORD}"
    },
    {
      "click": "form button[type=submit]"
    },
    {
      "waitForText": "SLA risk board"
    }
  ],
  "shots": [
    {
      "id": "03-command-center-agent",
      "file": "03-command-center-agent.png",
      "steps": [
        {
          "wait": 1500
        },
        {
          "eval": "document.querySelectorAll('desk-sla-risk-board .board').forEach(e => e.style.overflowY = 'hidden')"
        }
      ],
      "highlight": [
        "sd-page-header [sdPageActions]:first-child",
        "a[href='/tickets'][sdButton]",
        "section.kpis",
        "sd-card:has(desk-sla-risk-board)",
        "sd-card[title='My open tickets by status']",
        "sd-card:has(desk-team-workload)",
        "sd-card[title='Customer replies & mentions']",
        "sd-card[title='Pending approvals']",
        "sd-card[title='Escalations']"
      ],
      "numbered": true,
      "fullPage": true
    },
    {
      "id": "03-my-team",
      "file": "03-my-team.png",
      "clip": "sd-card:has(desk-team-workload)"
    },
    {
      "id": "03-my-open-tickets",
      "file": "03-my-open-tickets.png",
      "clip": "sd-card[title='My open tickets by status']"
    }
  ]
}
