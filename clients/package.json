{
  "name": "supportdesk-clients",
  "version": "0.1.0",
  "private": true,
  "description": "SupportDesk frontends: @sd/core (API + app services), @sd/ui (design system), desk (agent workbench + admin console), portal (customer portal) and mobile (Ionic + Capacitor).",
  "scripts": {
    "ng": "ng",
    "start:desk": "ng serve desk",
    "start:portal": "ng serve portal",
    "start:mobile": "ng serve mobile",
    "build:desk": "node scripts/ng-build.mjs desk",
    "build:portal": "node scripts/ng-build.mjs portal",
    "build:mobile": "node scripts/ng-build.mjs mobile",
    "build": "npm run build:desk && npm run build:portal",
    "watch:desk": "ng build desk --watch --configuration development",
    "check:libs": "tsc -p tsconfig.libs.json --noEmit",
    "check:desk": "ngc -p projects/desk/tsconfig.app.json --noEmit",
    "check:portal": "ngc -p projects/portal/tsconfig.app.json --noEmit",
    "check:mobile": "ngc -p projects/mobile/tsconfig.app.json --noEmit",
    "check": "npm run check:libs && npm run check:desk && npm run check:portal && npm run check:mobile",
    "cap:sync": "ng build mobile && cap sync"
  },
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@ionic/angular": "~8.8.19",
    "@microsoft/signalr": "^10.0.11",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-youtube": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "echarts": "^6.1.0",
    "ionicons": "^8.1.0",
    "lucide": "^1.56.0",
    "qrcode-generator": "^2.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/cli": "^8.5.2",
    "typescript": "~5.9.2"
  }
}
