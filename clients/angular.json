{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "cache": {
      "enabled": false
    }
  },
  "newProjectRoot": "projects",
  "projects": {
    "desk": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "css",
          "skipTests": true,
          "changeDetection": "OnPush",
          "prefix": "desk"
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/desk",
      "sourceRoot": "projects/desk/src",
      "prefix": "desk",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/desk/src/main.ts",
            "index": "projects/desk/src/index.html",
            "tsConfig": "projects/desk/tsconfig.app.json",
            "baseHref": "/",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/desk/public"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/inter/index.css",
              "projects/ui/src/styles/sd-ui.css",
              "projects/desk/src/styles.css"
            ],
            "outputPath": {
              "base": "../src/SupportDesk.Api/wwwroot",
              "browser": ""
            }
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "2.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "32kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "desk:build:production"
            },
            "development": {
              "buildTarget": "desk:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4830,
            "proxyConfig": "projects/desk/proxy.conf.json"
          }
        }
      }
    },
    "portal": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "css",
          "skipTests": true,
          "changeDetection": "OnPush",
          "prefix": "portal"
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/portal",
      "sourceRoot": "projects/portal/src",
      "prefix": "portal",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/portal/src/main.ts",
            "index": "projects/portal/src/index.html",
            "tsConfig": "projects/portal/tsconfig.app.json",
            "baseHref": "/portal/",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/portal/public"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/inter/index.css",
              "projects/ui/src/styles/sd-ui.css",
              "projects/portal/src/styles.css"
            ],
            "outputPath": {
              "base": "../src/SupportDesk.Api/wwwroot/portal",
              "browser": ""
            }
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "2.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "32kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "portal:build:production"
            },
            "development": {
              "buildTarget": "portal:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4831,
            "proxyConfig": "projects/portal/proxy.conf.json"
          }
        }
      }
    },
    "mobile": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "css",
          "skipTests": true,
          "changeDetection": "OnPush",
          "prefix": "m"
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/mobile",
      "sourceRoot": "projects/mobile/src",
      "prefix": "m",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/mobile/src/main.ts",
            "index": "projects/mobile/src/index.html",
            "tsConfig": "projects/mobile/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/mobile/public"
              }
            ],
            "styles": [
              "node_modules/@ionic/angular/css/core.css",
              "node_modules/@ionic/angular/css/normalize.css",
              "node_modules/@ionic/angular/css/structure.css",
              "node_modules/@ionic/angular/css/typography.css",
              "node_modules/@ionic/angular/css/display.css",
              "node_modules/@ionic/angular/css/padding.css",
              "node_modules/@ionic/angular/css/flex-utils.css",
              "node_modules/@ionic/angular/css/text-alignment.css",
              "node_modules/@ionic/angular/css/palettes/dark.class.css",
              "node_modules/@fontsource-variable/inter/index.css",
              "projects/ui/src/styles/sd-tokens.css",
              "projects/mobile/src/theme.css"
            ],
            "outputPath": {
              "base": "dist/mobile"
            }
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "32kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "mobile:build:production"
            },
            "development": {
              "buildTarget": "mobile:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4832,
            "proxyConfig": "projects/mobile/proxy.conf.json"
          }
        }
      }
    }
  }
}
