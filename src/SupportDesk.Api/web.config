<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for the SupportDesk API + desk/portal SPAs (ASP.NET Core Module V2, in-process).
  `dotnet publish` keeps this file and fills in processPath/arguments for the published app.
  Requires the ASP.NET Core 10 Hosting Bundle and the IIS "WebSocket Protocol" feature (SignalR).
  Environment-specific settings (connection string, master key, data path) belong in environment variables or
  appsettings.Production.json — see docs/DEPLOYMENT.md §4 and deploy/iis/Install-SupportDesk.ps1.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <!-- WebDAV intercepts PUT/DELETE/PATCH (405) when the feature is installed. -->
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <aspNetCore processPath="dotnet" arguments=".\SupportDesk.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" startupTimeLimit="300" shutdownTimeLimit="30" />
      <!-- SignalR (/hubs/*) uses WebSockets when the IIS "WebSocket Protocol" feature is installed (enabled by default; the
           <webSocket> section is locked at server level, so it is not set here) and falls back to long polling otherwise. -->
      <security>
        <!-- Uploads and KB imports accept up to 110 MB (endpoint limits are enforced by the app); long analytics query strings. -->
        <requestFiltering>
          <requestLimits maxAllowedContentLength="115343360" maxUrl="8192" maxQueryString="8192" />
        </requestFiltering>
      </security>
      <!-- Keep the API's problem+json bodies (404/409/422/…) instead of IIS error pages. -->
      <httpErrors existingResponse="PassThrough" />
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
