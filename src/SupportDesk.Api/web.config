<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for the SupportDesk API + desk/portal SPAs (ASP.NET Core Module V2, in-process).
  `dotnet publish` keeps this file and fills in processPath/arguments for the published app.
  Requires the ASP.NET Core 10 Hosting Bundle and the IIS "WebSocket Protocol" feature (SignalR).
  Environment-specific settings (connection string, master key, data path) belong in environment variables or
  appsettings.Production.json — see docs/DEPLOYMENT.md §4 and deploy/iis/Install-SupportDesk.ps1.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Only sections IIS leaves unlocked for sites by default: a locked one (modules, webSocket, httpLogging,
           serverRuntime…) fails every request with 500.19. Server-level settings are made by Install-SupportDesk.ps1. -->
      <handlers>
        <!-- WebDAV intercepts PUT/DELETE/PATCH (405) when the feature is installed; the install script also removes
             its module for the app (the modules section is locked on many servers). -->
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\SupportDesk.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" startupTimeLimit="300" shutdownTimeLimit="30" />
      <!-- SignalR (/hubs/*) uses WebSockets when the IIS "WebSocket Protocol" feature is installed (enabled by default; the
           <webSocket> section is locked at server level, so it is not set here) and falls back to long polling otherwise. -->
      <security>
        <!-- Uploads and KB imports accept up to 110 MB (endpoint limits are enforced by the app); long analytics query strings. -->
        <requestFiltering>
          <requestLimits maxAllowedContentLength="115343360" maxUrl="8192" maxQueryString="8192" />
        </requestFiltering>
      </security>
      <!-- "Auto": the app's own responses (problem+json 4xx/5xx) pass through unchanged, while errors raised by IIS itself
           (500.19 configuration errors, 500.3x start-up failures) still show IIS's error page — detailed when browsed on
           the server. "PassThrough" would turn those into blank 500s. -->
      <httpErrors existingResponse="Auto" />
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
